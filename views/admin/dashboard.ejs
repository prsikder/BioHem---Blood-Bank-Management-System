<% layout('layouts/main') -%>

<style>
    .admin-dashboard {
        min-height: calc(100vh - 200px);
    }
    
    /* Fix responsive grid issues */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 1.5rem;
    }
    
    /* Fix card heights */
    .dashboard-card {
        height: 100%;
        min-height: 140px;
    }
    
    /* Fix table responsiveness */
    .responsive-table {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }
    
    /* Hospital Map Styles */
    .hospital-marker-inner {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 2px solid white;
        box-shadow: 0 2px 5px rgba(0,0,0,0.3);
    }
    
    #hospitalMap {
        height: 400px;
        border-radius: 8px;
        z-index: 1;
    }
    
    /* Fix mobile layout */
    @media (max-width: 768px) {
        .dashboard-card {
            min-height: 120px;
        }
        
        .stats-grid {
            grid-template-columns: 1fr;
        }
        
        #hospitalMap {
            height: 300px;
        }
    }
</style>

<!-- Leaflet CSS -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<div class="admin-dashboard container-fluid py-4">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4">
        <div class="mb-3 mb-md-0">
            <h1 class="h2 fw-bold text-dark mb-2">
                <i class="bi bi-speedometer2 text-danger me-2"></i>Admin Dashboard
            </h1>
            <p class="text-muted mb-0">Monitor and manage the blood bank system</p>
        </div>
        <div class="d-flex align-items-center">
            <span class="badge bg-light text-dark me-3">
                <i class="bi bi-clock me-1"></i>
                <%= new Date().toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %>
            </span>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="stats-grid mb-4">
        <!-- Donors Card -->
        <div class="card border-0 shadow-sm dashboard-card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <h6 class="text-muted mb-2">Total Donors</h6>
                        <h2 class="fw-bold text-danger mb-0"><%= donors %></h2>
                        <div class="mt-2">
                            <a href="/donors" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-eye me-1"></i>View
                            </a>
                        </div>
                    </div>
                    <div class="bg-danger bg-opacity-10 p-3 rounded-circle">
                        <i class="bi bi-people-fill text-danger fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Hospitals Card -->
        <div class="card border-0 shadow-sm dashboard-card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <h6 class="text-muted mb-2">Partner Hospitals</h6>
                        <h2 class="fw-bold text-primary mb-0"><%= hospitals %></h2>
                        <div class="mt-2">
                            <a href="/hospitals" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-eye me-1"></i>View
                            </a>
                        </div>
                    </div>
                    <div class="bg-primary bg-opacity-10 p-3 rounded-circle">
                        <i class="bi bi-hospital-fill text-primary fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Blood Stock Card -->
        <div class="card border-0 shadow-sm dashboard-card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <h6 class="text-muted mb-2">Blood Stock</h6>
                        <h2 class="fw-bold text-warning mb-0"><%= totalStockUnits %></h2>
                        <div class="mt-2">
                            <a href="#blood-inventory" class="btn btn-sm btn-outline-warning">
                                <i class="bi bi-eye me-1"></i>View
                            </a>
                        </div>
                    </div>
                    <div class="bg-warning bg-opacity-10 p-3 rounded-circle">
                        <i class="bi bi-droplet-fill text-warning fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Pending Requests Card -->
        <div class="card border-0 shadow-sm dashboard-card border-start border-4 border-danger">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <h6 class="text-muted mb-2">Pending Requests</h6>
                        <h2 class="fw-bold text-danger mb-0"><%= requests.length %></h2>
                        <div class="mt-2">
                            <a href="#pending-requests" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-eye me-1"></i>View
                            </a>
                        </div>
                    </div>
                    <div class="bg-danger bg-opacity-10 p-3 rounded-circle">
                        <i class="bi bi-bell-fill text-danger fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="row g-4">
        <!-- Left Column - 8/12 -->
        <div class="col-xl-8">
            <!-- Blood Inventory -->
            <div class="card border-0 shadow-sm mb-4" id="blood-inventory">
                <div class="card-header bg-white border-0 py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="fw-bold mb-0">
                            <i class="bi bi-box-seam text-danger me-2"></i>Blood Inventory
                        </h5>
                        <a href="/admin/stock-export" class="btn btn-sm btn-outline-danger">
                            <i class="bi bi-download me-1"></i>Export
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    <% if (stockRows && stockRows.length) { %>
                        <div class="responsive-table">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Blood Group</th>
                                        <th class="text-end">Units</th>
                                        <th class="text-center">Status</th>
                                        <th class="text-center">Add Stock</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% stockRows.forEach(r => { 
                                        const units = Number(r.units || 0);
                                        let status = 'success';
                                        let statusText = 'Good';
                                        if (units < 5) {
                                            status = 'danger';
                                            statusText = 'Low';
                                        } else if (units < 10) {
                                            status = 'warning';
                                            statusText = 'Medium';
                                        }
                                    %>
                                        <tr>
                                            <td>
                                                <span class="badge bg-danger bg-opacity-10 text-danger p-2">
                                                    <strong><%= r.blood_group %></strong>
                                                </span>
                                            </td>
                                            <td class="text-end">
                                                <h5 class="fw-bold mb-0"><%= units %></h5>
                                                <small class="text-muted">units</small>
                                            </td>
                                            <td class="text-center">
                                                <span class="badge bg-<%= status %> bg-opacity-10 text-<%= status %>">
                                                    <i class="bi bi-circle-fill me-1"></i><%= statusText %>
                                                </span>
                                            </td>
                                            <td class="text-center">
                                                <form method="post" action="/admin/add-stock" class="d-inline">
                                                    <input type="hidden" name="blood_group" value="<%= r.blood_group %>">
                                                    <input type="number" name="units" min="1" max="50" value="1" 
                                                           class="form-control form-control-sm d-inline" style="width: 70px;">
                                                    <button type="submit" class="btn btn-sm btn-outline-primary ms-2">
                                                        <i class="bi bi-plus"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    <% } else { %>
                        <div class="text-center py-4">
                            <i class="bi bi-inboxes text-muted fs-1 mb-3"></i>
                            <p class="text-muted">No stock records found</p>
                        </div>
                    <% } %>
                </div>
            </div>

        </div>

        <!-- Right Column - 4/12 -->
        <div class="col-xl-4">
            <!-- Quick Actions -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-lightning-charge-fill text-primary me-2"></i>Quick Actions
                    </h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a href="/donors/create" class="btn btn-outline-danger text-start py-3">
                            <i class="bi bi-person-plus-fill me-2"></i>Add New Donor
                        </a>
                        <a href="/hospitals/create" class="btn btn-outline-primary text-start py-3">
                            <i class="bi bi-hospital-fill me-2"></i>Add New Hospital
                        </a>
                        <a href="/admin/logs" class="btn btn-outline-success text-start py-3">
                            <i class="bi bi-clock-history me-2"></i>View Activity Logs
                        </a>
                    </div>
                </div>
            </div>

            <!-- Low Stock Alert -->
            <div class="card border-0 shadow-sm mb-4 border-start border-4 border-danger">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="fw-bold mb-0 text-danger">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>Low Stock Alert
                    </h5>
                </div>
                <div class="card-body">
                    <% if (lowStock && lowStock.length) { %>
                        <div class="list-group list-group-flush">
                            <% lowStock.forEach(s => { %>
                                <div class="list-group-item border-0 px-0 py-2">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="badge bg-danger bg-opacity-10 text-danger p-2">
                                            <%= s.blood_group %>
                                        </span>
                                        <div class="text-end">
                                            <h5 class="fw-bold text-danger mb-0"><%= s.units %></h5>
                                            <small class="text-muted">units left</small>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <div class="text-center py-3">
                            <i class="bi bi-check-circle-fill text-success fs-1 mb-2"></i>
                            <p class="text-success fw-bold mb-0">All stock levels are good</p>
                        </div>
                    <% } %>
                </div>
            </div>

            <!-- Pending Requests -->
            <div class="card border-0 shadow-sm" id="pending-requests">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-bell-fill text-warning me-2"></i>Pending Requests
                        <span class="badge bg-danger ms-2"><%= requests.length %></span>
                    </h5>
                </div>
                <div class="card-body p-0">
                    <% if (requests && requests.length) { %>
                        <div class="list-group list-group-flush">
                            <% requests.forEach(r => { %>
                                <div class="list-group-item border-0 px-0 py-3">
                                    <div class="mb-2">
                                        <h6 class="fw-bold mb-1 text-truncate">
                                            <%= r.hospital_name || ('Hospital #' + r.hospital_id) %>
                                        </h6>
                                        <div class="d-flex align-items-center gap-2 mb-1">
                                            <span class="badge bg-danger bg-opacity-10 text-danger">
                                                <%= r.blood_group %>
                                            </span>
                                            <span class="small">
                                                <%= r.units %> units
                                            </span>
                                            <% if (r.urgency === 'Emergency') { %>
                                                <span class="badge bg-danger">
                                                    <i class="bi bi-exclamation-triangle me-1"></i>Emergency
                                                </span>
                                            <% } else { %>
                                                <span class="badge bg-secondary">
                                                    <i class="bi bi-clock me-1"></i>General
                                                </span>
                                            <% } %>
                                        </div>
                                        <small class="text-muted">
                                            <i class="bi bi-clock me-1"></i>
                                            <%= new Date(r.created_at).toLocaleDateString() %>
                                        </small>
                                    </div>
                                    <div class="d-flex gap-2">
                                        <form method="post" action="/admin/requests/<%= r.id %>/fulfill" class="flex-grow-1">
                                            <button class="btn btn-success btn-sm w-100">
                                                <i class="bi bi-check-circle me-1"></i>Approve
                                            </button>
                                        </form>
                                        <form method="post" action="/admin/requests/<%= r.id %>/reject" class="flex-grow-1">
                                            <button class="btn btn-outline-danger btn-sm w-100">
                                                <i class="bi bi-x-circle me-1"></i>Reject
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <div class="text-center py-4">
                            <i class="bi bi-inbox text-muted fs-1 mb-3"></i>
                            <p class="text-muted">No pending requests</p>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Leaflet JS -->
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

