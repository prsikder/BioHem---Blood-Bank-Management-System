<% layout('layouts/main') -%>
<h2>Activity Logs</h2>
<table class="table table-sm">
  <thead><tr><th>Time</th><th>Actor</th><th>Action</th><th>Details</th></tr></thead>
  <tbody>
    <% if (logs && logs.length) { logs.forEach(l => { %>
      <tr><td><%= new Date(l.created_at).toLocaleString() %></td><td><%= l.actor %></td><td><%= l.action %></td><td><%= l.details %></td></tr>
    <% }) } else { %>
      <tr><td colspan="4">No logs</td></tr>
    <% } %>
  </tbody>
</table>
