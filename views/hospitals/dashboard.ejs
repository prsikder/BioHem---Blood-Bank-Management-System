<% layout('layouts/main') -%>

<style>
    .hospital-dashboard {
        min-height: calc(100vh - 200px);
    }
    
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 1.5rem;
        margin-bottom: 2rem;
    }
    
    .dashboard-card {
        height: 100%;
        border-radius: 12px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    
    .dashboard-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 25px rgba(0,0,0,0.1) !important;
    }
    
    .request-status-badge {
        font-size: 0.75rem;
        padding: 0.25rem 0.75rem;
    }
    
    @media (max-width: 768px) {
        .stats-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="hospital-dashboard container-fluid py-4">
    <!-- Header with Hospital Info -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4">
        <div class="mb-3 mb-md-0">
            <h1 class="h2 fw-bold text-dark mb-2">
                <i class="bi bi-hospital-fill text-primary me-2"></i><%= hospital.name %> Dashboard
            </h1>
            <div class="d-flex flex-wrap gap-2 align-items-center">
                <span class="badge bg-primary bg-opacity-10 text-primary">
                    <i class="bi bi-geo-alt-fill me-1"></i><%= hospital.city %>
                </span>
                <span class="badge bg-secondary bg-opacity-10 text-secondary">
                    <i class="bi bi-telephone-fill me-1"></i><%= hospital.phone || 'No phone' %>
                </span>
                <% if (hospital.latitude && hospital.longitude) { %>
                    <span class="badge bg-success bg-opacity-10 text-success">
                        <i class="bi bi-geo-fill me-1"></i>Location Set
                    </span>
                <% } %>
            </div>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="stats-grid">
        <!-- Total Requests Card -->
        <div class="card border-0 shadow-sm dashboard-card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <h6 class="text-muted mb-2">Total Requests</h6>
                        <h2 class="fw-bold text-primary mb-0"><%= stats.totalRequests %></h2>
                        <div class="mt-2">
                            <span class="badge bg-primary bg-opacity-10 text-primary">
                                <i class="bi bi-file-earmark-text me-1"></i>All Time
                            </span>
                        </div>
                    </div>
                    <div class="bg-primary bg-opacity-10 p-3 rounded-circle">
                        <i class="bi bi-clipboard-data text-primary fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Pending Requests Card -->
        <div class="card border-0 shadow-sm dashboard-card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <h6 class="text-muted mb-2">Pending Requests</h6>
                        <h2 class="fw-bold text-warning mb-0"><%= stats.pendingRequests %></h2>
                        <div class="mt-2">
                            <span class="badge bg-warning bg-opacity-10 text-warning">
                                <i class="bi bi-clock-history me-1"></i>Awaiting
                            </span>
                        </div>
                    </div>
                    <div class="bg-warning bg-opacity-10 p-3 rounded-circle">
                        <i class="bi bi-hourglass-split text-warning fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Fulfilled Requests Card -->
        <div class="card border-0 shadow-sm dashboard-card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <h6 class="text-muted mb-2">Fulfilled Requests</h6>
                        <h2 class="fw-bold text-success mb-0"><%= stats.fulfilledRequests %></h2>
                        <div class="mt-2">
                            <span class="badge bg-success bg-opacity-10 text-success">
                                <i class="bi bi-check-circle me-1"></i>Completed
                            </span>
                        </div>
                    </div>
                    <div class="bg-success bg-opacity-10 p-3 rounded-circle">
                        <i class="bi bi-check2-circle text-success fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Emergency Requests Card -->
        <div class="card border-0 shadow-sm dashboard-card border-start border-4 border-danger">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <h6 class="text-muted mb-2">Emergency Requests</h6>
                        <h2 class="fw-bold text-danger mb-0"><%= stats.emergencyRequests %></h2>
                        <div class="mt-2">
                            <span class="badge bg-danger bg-opacity-10 text-danger">
                                <i class="bi bi-exclamation-triangle me-1"></i>Urgent
                            </span>
                        </div>
                    </div>
                    <div class="bg-danger bg-opacity-10 p-3 rounded-circle">
                        <i class="bi bi-activity text-danger fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Blood Requests Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-0 py-3">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0">
                    <i class="bi bi-clock-history text-primary me-2"></i>Recent Blood Requests
                </h5>
            </div>
        </div>
        <div class="card-body p-0">
            <% if (recentRequests && recentRequests.length) { %>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="border-0 ps-4">Request ID</th>
                                <th class="border-0">Blood Group</th>
                                <th class="border-0">Units</th>
                                <th class="border-0">Urgency</th>
                                <th class="border-0">Status</th>
                                <th class="border-0">Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% recentRequests.forEach(request => { 
                                let statusClass = 'secondary';
                                let statusIcon = 'clock';
                                if (request.status === 'fulfilled') {
                                    statusClass = 'success';
                                    statusIcon = 'check-circle';
                                } else if (request.status === 'rejected') {
                                    statusClass = 'danger';
                                    statusIcon = 'x-circle';
                                } else if (request.status === 'pending') {
                                    statusClass = 'warning';
                                    statusIcon = 'hourglass-split';
                                }
                                
                                let urgencyClass = 'secondary';
                                if (request.urgency === 'Emergency') {
                                    urgencyClass = 'danger';
                                }
                            %>
                                <tr>
                                    <td class="ps-4">
                                        <span class="badge bg-light text-dark">#<%= request.id %></span>
                                    </td>
                                    <td>
                                        <span class="badge bg-danger bg-opacity-10 text-danger p-2">
                                            <i class="bi bi-droplet-fill me-1"></i><%= request.blood_group %>
                                        </span>
                                    </td>
                                    <td>
                                        <h6 class="fw-bold mb-0"><%= request.units %></h6>
                                        <small class="text-muted">units</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-<%= urgencyClass %> bg-opacity-10 text-<%= urgencyClass %> request-status-badge">
                                            <i class="bi bi-<%= request.urgency === 'Emergency' ? 'exclamation-triangle' : 'info-circle' %> me-1"></i>
                                            <%= request.urgency %>
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge bg-<%= statusClass %> bg-opacity-10 text-<%= statusClass %> request-status-badge">
                                            <i class="bi bi-<%= statusIcon %> me-1"></i>
                                            <%= request.status.charAt(0).toUpperCase() + request.status.slice(1) %>
                                        </span>
                                    </td>
                                    <td>
                                        <div class="small">
                                            <%= new Date(request.created_at).toLocaleDateString() %>
                                            <div class="very-small text-muted">
                                                <%= new Date(request.created_at).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <div class="text-center py-5">
                    <div class="mb-3">
                        <i class="bi bi-inbox text-muted fs-1"></i>
                    </div>
                    <h5 class="text-muted">No requests yet</h5>
                    <p class="text-muted mb-3">Create your first blood request to get started</p>
                    <a href="/hospitals/<%= hospital.id %>/request" class="btn btn-danger">
                        <i class="bi bi-plus-circle me-1"></i>Create First Request
                    </a>
                </div>
            <% } %>
        </div>
        <% if (recentRequests && recentRequests.length) { %>
            <div class="card-footer bg-white border-0 py-3">
            </div>
        <% } %>
    </div>

    <!-- Quick Stats Row -->
    <div class="row mt-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted mb-3">
                        <i class="bi bi-pie-chart-fill me-2"></i>Request Status Distribution
                    </h6>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span>Pending</span>
                        <span class="fw-bold"><%= stats.pendingRequests %></span>
                    </div>
                    <div class="progress mb-3" style="height: 8px;">
                        <div class="progress-bar bg-warning" 
                             style="width: <%= stats.totalRequests > 0 ? (stats.pendingRequests / stats.totalRequests * 100) : 0 %>%">
                        </div>
                    </div>
                    
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span>Fulfilled</span>
                        <span class="fw-bold"><%= stats.fulfilledRequests %></span>
                    </div>
                    <div class="progress mb-3" style="height: 8px;">
                        <div class="progress-bar bg-success" 
                             style="width: <%= stats.totalRequests > 0 ? (stats.fulfilledRequests / stats.totalRequests * 100) : 0 %>%">
                        </div>
                    </div>
                    
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span>Rejected</span>
                        <span class="fw-bold"><%= stats.rejectedRequests %></span>
                    </div>
                    <div class="progress" style="height: 8px;">
                        <div class="progress-bar bg-danger" 
                             style="width: <%= stats.totalRequests > 0 ? (stats.rejectedRequests / stats.totalRequests * 100) : 0 %>%">
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted mb-3">
                        <i class="bi bi-lightning-charge-fill me-2"></i>Quick Actions
                    </h6>
                    <div class="d-grid gap-2">
                        <a href="/hospitals/<%= hospital.id %>/request" class="btn btn-outline-primary text-start py-2">
                            <i class="bi bi-plus-circle me-2"></i>New Blood Request
                        </a>
                        <a href="/hospitals/<%= hospital.id %>/edit" class="btn btn-outline-primary text-start py-2">
                            <i class="bi bi-gear me-2"></i>Update Hospital Profile
                        </a>
                        <a href="/hospitals" class="btn btn-outline-primary text-start py-2">
                            <i class="bi bi-houses me-2"></i>View Other Hospitals
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Initialize tooltips
    document.addEventListener('DOMContentLoaded', function() {
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl);
        });
    });
</script>