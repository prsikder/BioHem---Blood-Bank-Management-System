                        <a href="https://www.instagram.com/_reyaaaa_?igsh=dHRkazJ3ZG55aG9o" class="text-white"><i class="bi bi-instagram"></i></a>
                        <a href="www.linkedin.com/in/pushpita-reya-174248262" class="text-white"><i class="bi bi-linkedin"></i></a>
                        <a href="https://github.com/prsikder" class="text-white"><i class="bi bi-github"></i></a>
                    </div>
                </div>
                <div class="col-lg-4 mb-3">
                    <h6>Quick Links</h6>
                    <ul class="list-unstyled small">
                        <li><a href="/" class="text-light text-decoration-none">Home</a></li>
                        <li><a href="/auth/login" class="text-light text-decoration-none">Login</a></li>
                        <li><a href="/auth/register/donor" class="text-light text-decoration-none">Become a Donor</a></li>
                        <li><a href="/auth/register/hospital" class="text-light text-decoration-none">Hospital Registration</a></li>
                        <li><a href="/donors" class="text-light text-decoration-none">Find Donors</a></li>
                        <li><a href="/hospitals" class="text-light text-decoration-none">Find Hospitals</a></li>
                    </ul>
                </div>
                <div class="col-lg-4 mb-3">
                    <h6>Contact & Info</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-2">
                            <i class="bi bi-person-circle me-2"></i>
                            <strong>Pushpita Sikder Reya</strong>
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-mortarboard-fill me-2"></i>
                            <strong>Sylhet Engineering College</strong>
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-envelope me-2"></i>
                            pushpitareya@gmail.com
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-geo-alt me-2"></i>
                            Sylhet, Bangladesh
                        </li>
                        <li>
                            <i class="bi bi-code-slash me-2"></i>
                            CSE Student Project 2026
                        </li>
                    </ul>
                </div>
            </div>
            <hr class="bg-light my-3">
            <div class="row align-items-center">
                <div class="col-md-4 mb-3 mb-md-0">
                    <div class="d-flex align-items-center">
                        <img src="/images/college-placeholder.png" alt="SEC Logo" height="30" class="me-2">
                        <span class="small text-light">Sylhet Engineering College</span>
                    </div>
                </div>
                <div class="col-md-4 text-center mb-3 mb-md-0">
                    <p class="small mb-0">&copy; 2026 BioHem Blood Bank System. All rights reserved.</p>
                </div>
                <div class="col-md-4 text-md-end">
                    <p class="small mb-0">Designed with <i class="bi bi-heart-fill text-danger"></i> to save lives</p>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.js"></script>
    <script>
        // Auto-dismiss alerts after 5 seconds
        document.addEventListener('DOMContentLoaded', function() {
            setTimeout(() => {
                const alerts = document.querySelectorAll('.alert');
                alerts.forEach(alert => {
                    const bsAlert = new bootstrap.Alert(alert);
                    bsAlert.close();
                });
            }, 5000);
        });
    </script>
    <script>
/* =====================
   LOGIN PAGE SCRIPT
   ===================== */

const togglePassword = document.getElementById('togglePassword');
const passwordInput = document.getElementById('passwordInput');
const eyeIcon = document.getElementById('eyeIcon');

if (togglePassword && passwordInput && eyeIcon) {
    togglePassword.addEventListener('click', () => {
        const isPassword = passwordInput.type === 'password';
        passwordInput.type = isPassword ? 'text' : 'password';
        eyeIcon.className = isPassword ? 'bi bi-eye-slash' : 'bi bi-eye';
    });
}

// Demo credentials
window.fillDemoCredentials = function(email, password) {
    const emailInput = document.querySelector('input[name="email"]');
    const passInput = document.querySelector('input[name="password"]');
    const form = document.getElementById('loginForm');

    if (emailInput && passInput) {
        emailInput.value = email;
        passInput.value = password;
    }

    if (form) {
        form.classList.add('animate__pulse');
        setTimeout(() => form.classList.remove('animate__pulse'), 500);
    }
};

// Validation
const loginForm = document.getElementById('loginForm');
if (loginForm) {
    loginForm.addEventListener('submit', function(e) {
        if (!this.email.value || !this.password.value) {
            e.preventDefault();
            alert('Please fill in all fields');
        }
    });
}
</script>

</body>
</html>