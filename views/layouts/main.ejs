<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BioHem - Blood Bank Management</title>
    
    <!-- Bootstrap 5.3 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <!-- Animate.css for animations -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">
    
    <style>
        :root {
            --primary-red: #d32f2f;
            --primary-red-dark: #b71c1c;
            --secondary-blue: #1976d2;
            --accent-green: #388e3c;
            --text-dark: #2c3e50;
            --text-light: #546e7a;
            --bg-light: #f8f9fa;
            --bg-white: #ffffff;
            --shadow: 0 8px 30px rgba(0,0,0,0.08);
            --shadow-light: 0 4px 12px rgba(0,0,0,0.05);
        }
        
        * {
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-dark sticky-top" style="background: linear-gradient(135deg, var(--primary-red) 0%, var(--primary-red-dark) 100%);">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center" href="/">
                <!-- Using your BioHem logo -->
                <img src="/images/blood-hero.png" alt="BioHem Logo" height="40" class="me-2">
                <span class="fw-bold fs-4 text-white">BioHem</span>
            </a>
            
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <% if (!user) { %>
                        <li class="nav-item">
                            <a class="nav-link active" href="/">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link active" href="/auth/login">Login</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link active" href="/auth/register/donor">Donor Signup</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link active" href="/auth/register/hospital">Hospital Signup</a>
                        </li>
                    <% } else { %>
                
                        <% if (user.role === 'admin') { %>
                            <li class="nav-item">
                                <a class="nav-link active" href="/admin"></a>
                            </li>
                        <% } %>
                        <li class="nav-item">
                            <a class="nav-link" href="/auth/logout">Logout</a>
                        </li>
                    <% } %>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Flash Messages -->
    <% if (success && success.length) { %>
        <div class="container mt-3">
            <% success.forEach(msg => { %>
                <div class="alert alert-success alert-dismissible fade show animate__animated animate__fadeInDown" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i><%= msg %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% }) %>
        </div>
    <% } %>
    <% if (error && error.length) { %>
        <div class="container mt-3">
            <% error.forEach(msg => { %>
                <div class="alert alert-danger alert-dismissible fade show animate__animated animate__shakeX" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i><%= msg %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% }) %>
        </div>
    <% } %>

    <!-- Main Content -->
    <main class="flex-grow-1">
        <%- body %>
    </main>

    <!-- Footer -->
    <footer class="bg-dark text-white mt-5 pt-4 pb-3">
