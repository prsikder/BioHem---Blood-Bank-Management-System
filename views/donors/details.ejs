<% layout('layouts/main') -%>

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/donors">Donors</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Donor Details</li>
                </ol>
            </nav>
            <h1 class="h2 fw-bold mb-0">Donor Profile</h1>
        </div>
        <div>
            <% if (user && (user.role === 'admin' || user.donor_id === donor.id)) { %>
                <a class="btn btn-warning" href="/donors/<%= donor.id %>/edit">
                    <i class="bi bi-pencil-square me-1"></i>Edit Profile
                </a>
            <% } %>
            <a href="/donors" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>Back to List
            </a>
        </div>
    </div>

    <div class="row g-4">
        <!-- Left Column - Profile -->
        <div class="col-lg-4">
            <!-- Profile Card -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body text-center p-4">
                    <!-- Photo -->
                    <div class="mb-4">
                        <% if (donor.photo) { %>
                            <img src="<%= donor.photo %>" alt="<%= donor.name %>" 
                                 class="rounded-circle border border-4 border-white shadow" 
                                 style="width: 150px; height: 150px; object-fit: cover;">
                        <% } else { %>
                            <div class="rounded-circle border border-4 border-white shadow bg-danger bg-opacity-10 d-flex align-items-center justify-content-center mx-auto" 
                                 style="width: 150px; height: 150px;">
                                <i class="bi bi-person-fill text-danger" style="font-size: 4rem;"></i>
                            </div>
                        <% } %>
                    </div>
                    
                    <!-- Name & Blood Group -->
                    <h3 class="fw-bold mb-2"><%= donor.name %></h3>
                    <% if (donor.blood_group) { %>
                        <div class="mb-3">
                            <span class="badge bg-danger bg-opacity-10 text-danger p-2 fs-6">
                                <i class="bi bi-droplet-fill me-1"></i>Blood Group: <%= donor.blood_group %>
                            </span>
                        </div>
                    <% } %>
                    
                    <!-- Eligibility Badge -->
                    <div class="mb-4">
                        <% if (eligible) { %>
                            <span class="badge bg-success bg-opacity-10 text-success p-2">
                                <i class="bi bi-check-circle-fill me-1"></i>Eligible to Donate
                            </span>
                        <% } else { %>
                            <span class="badge bg-warning bg-opacity-10 text-warning p-2">
                                <i class="bi bi-clock-history me-1"></i>Not Eligible Yet
                            </span>
                        <% } %>
                    </div>
                    
                    <!-- Quick Actions -->
                    <div class="d-grid gap-2">
                        <% if (user && user.role === 'admin') { %>
                            <button class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#recordDonationModal">
                                <i class="bi bi-plus-circle me-1"></i>Record Donation
                            </button>
                        <% } %>
                        <a href="mailto:<%= donor.email %>" class="btn btn-outline-primary">
                            <i class="bi bi-envelope me-1"></i>Send Email
                        </a>
                        <% if (donor.phone) { %>
                            <a href="tel:<%= donor.phone %>" class="btn btn-outline-success">
                                <i class="bi bi-telephone me-1"></i>Call Donor
                            </a>
                        <% } %>
                    </div>
                </div>
            </div>
            
            <!-- Quick Stats -->
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h6 class="fw-bold mb-3">Quick Stats</h6>
                    <div class="row g-2">
                        <div class="col-6">
                            <div class="text-center p-3 bg-light rounded-3">
                                <div class="text-danger fw-bold fs-4"><%= donations ? donations.length : 0 %></div>
                                <div class="small text-muted">Total Donations</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="text-center p-3 bg-light rounded-3">
                                <div class="text-primary fw-bold fs-4">
                                    <%= donor.last_donation_date ? 
                                        Math.floor((new Date() - new Date(donor.last_donation_date)) / (1000 * 60 * 60 * 24)) : 
                                        '—' %>
                                </div>
                                <div class="small text-muted">Days Since Last</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column - Details -->
        <div class="col-lg-8">
            <!-- Personal Information -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-0">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-person-vcard text-danger me-2"></i>Personal Information
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="d-flex align-items-center mb-3">
                                <div class="bg-danger bg-opacity-10 p-2 rounded-circle me-3">
                                    <i class="bi bi-envelope-fill text-danger"></i>
                                </div>
                                <div>
                                    <small class="text-muted d-block">Email</small>
                                    <strong><%= donor.email %></strong>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex align-items-center mb-3">
                                <div class="bg-danger bg-opacity-10 p-2 rounded-circle me-3">
                                    <i class="bi bi-telephone-fill text-danger"></i>
                                </div>
                                <div>
                                    <small class="text-muted d-block">Phone</small>
                                    <strong><%= donor.phone || 'Not provided' %></strong>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex align-items-center mb-3">
                                <div class="bg-danger bg-opacity-10 p-2 rounded-circle me-3">
                                    <i class="bi bi-geo-alt-fill text-danger"></i>
                                </div>
                                <div>
                                    <small class="text-muted d-block">City</small>
                                    <strong><%= donor.city || 'Not specified' %></strong>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex align-items-center mb-3">
                                <div class="bg-danger bg-opacity-10 p-2 rounded-circle me-3">
                                    <i class="bi bi-calendar3 text-danger"></i>
                                </div>
                                <div>
                                    <small class="text-muted d-block">Age</small>
                                    <strong><%= donor.age || '—' %></strong>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex align-items-center mb-3">
                                <div class="bg-danger bg-opacity-10 p-2 rounded-circle me-3">
                                    <i class="bi bi-calendar-check text-danger"></i>
                                </div>
                                <div>
                                    <small class="text-muted d-block">Last Donation</small>
                                    <strong><%= donor.last_donation_date ? 
                                        new Date(donor.last_donation_date).toLocaleDateString() : 
                                        'Never donated' %></strong>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex align-items-center mb-3">
                                <div class="bg-danger bg-opacity-10 p-2 rounded-circle me-3">
                                    <i class="bi bi-calendar-plus text-danger"></i>
                                </div>
                                <div>
                                    <small class="text-muted d-block">Joined Date</small>
                                    <strong><%= new Date(donor.created_at).toLocaleDateString() %></strong>
                                    <div class="very-small text-muted">
                                        <%= new Date(donor.created_at).toLocaleTimeString() %>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Donation History -->
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-clock-history text-danger me-2"></i>Donation History
                    </h5>
                    <% if (donations && donations.length) { %>
                        <span class="badge bg-danger"><%= donations.length %> donations</span>
                    <% } %>
                </div>
                <div class="card-body">
                    <% if (donations && donations.length) { %>
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Date & Time</th>
                                        <th>Blood Group</th>
                                        <th>Units</th>
                                        <th>Recorded By</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% donations.forEach(d => { %>
                                        <tr>
                                            <td>
                                                <%= new Date(d.created_at).toLocaleDateString() %>
                                                <div class="very-small text-muted">
                                                    <%= new Date(d.created_at).toLocaleTimeString() %>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="badge bg-danger bg-opacity-10 text-danger">
                                                    <%= d.blood_group %>
                                                </span>
                                            </td>
                                            <td><strong><%= d.units %></strong></td>
                                            <td><%= d.recorded_by %></td>
                                            <td>
                                                <span class="badge bg-success bg-opacity-10 text-success">
                                                    Completed
                                                </span>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    <% } else { %>
                        <div class="text-center py-4">
                            <i class="bi bi-inbox text-muted fs-1 mb-3"></i>
                            <h6 class="text-muted">No donation records yet</h6>
                            <p class="text-muted small">This donor hasn't made any donations yet.</p>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Record Donation Modal (Admin Only) -->
<% if (user && user.role === 'admin') { %>
    <div class="modal fade" id="recordDonationModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-plus-circle text-danger me-2"></i>Record New Donation
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form method="post" action="/donors/<%= donor.id %>/donate">
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Blood Group</label>
                            <input name="blood_group" class="form-control" 
                                   value="<%= donor.blood_group %>" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Units Donated</label>
                            <input type="number" name="units" class="form-control" 
                                   value="1" min="1" max="2" required>
                            <div class="form-text">Typically 1 unit = 450ml of blood</div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Donation Date</label>
                            <input type="datetime-local" name="donation_date" 
                                   class="form-control" 
                                   value="<%= new Date().toISOString().slice(0,16) %>">
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-check-circle me-1"></i>Record Donation
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
<% } %>

<style>
    .breadcrumb {
        background-color: transparent;
        padding: 0;
        margin-bottom: 0.5rem;
    }
    
    .breadcrumb-item.active {
        color: var(--primary-red);
    }
    
    .very-small {
        font-size: 0.75rem;
    }
    
    .modal-content {
        border-radius: var(--border-radius);
        border: none;
    }
    
    .modal-header {
        border-bottom: 1px solid rgba(0,0,0,0.05);
    }
</style>