<% layout('layouts/main') -%>

<!-- Hero Section -->
<section class="hero-section py-5" style="background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 animate__animated animate__fadeInLeft">
                <div class="d-flex align-items-center mb-4">
                    <img src="/images/blood-hero.png" alt="BioHem Logo" height="80" class="me-3">
                    <div>
                        <h1 class="display-4 fw-bold mb-0">Bio<span class="text-danger">Hem</span></h1>
                        <p class="text-muted">Blood Bank Management System</p>
                    </div>
                </div>
                <p class="lead text-muted mb-4">
                    Connecting compassionate donors with hospitals in need, ensuring that 
                    life-saving blood is available when it matters most. Join our community 
                    and be a hero in someone's life story.
                </p>
                <div class="d-flex flex-wrap gap-3 mb-5">
                    <a href="/auth/register/donor" class="btn btn-danger btn-lg px-4">
                        <i class="bi bi-heart-pulse me-2"></i>Become a Donor
                    </a>
                    <a href="/auth/register/hospital" class="btn btn-danger btn-lg px-4">
                        <i class="bi bi-hospital me-2"></i>Hospital Registration
                    </a>
                    <a href="/auth/login" class="btn btn-danger btn-lg px-4">
                        <i class="bi bi-box-arrow-in-right me-2"></i>Login
                    </a>
                </div>
                
                <!-- Quick Stats -->
                <div class="row text-center">
                    <div class="col-4">
                        <div class="stat-card p-3 bg-white rounded-3 shadow-sm">
                            <h3 class="text-danger fw-bold"><%= donors %></h3>
                            <p class="small text-muted mb-0">Active Donors</p>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="stat-card p-3 bg-white rounded-3 shadow-sm">
                            <h3 class="text-primary fw-bold"><%= hospitals %></h3>
                            <p class="small text-muted mb-0">Partner Hospitals</p>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="stat-card p-3 bg-white rounded-3 shadow-sm">
                            <h3 class="text-success fw-bold"><%= stock %></h3>
                            <p class="small text-muted mb-0">Blood Units Available</p>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-lg-6 animate__animated animate__fadeInRight">
                <div class="hero-image position-relative">
                    <!-- You can keep online image or replace with your own hero image -->
                    <img src="/images/blood-hero.png" 
                         alt="Blood Donation Hero" 
                         class="img-fluid rounded-4 shadow-lg">
                    <div class="floating-card position-absolute bg-white p-3 rounded-3 shadow" 
                         style="bottom: -20px; right: -20px; max-width: 300px;">
                        <div class="d-flex align-items-center">
                            <div class="bg-danger rounded-circle p-2 me-3">
                                <i class="bi bi-shield-check text-white fs-4"></i>
                            </div>
                            <div>
                                <h6 class="mb-1">Safe & Secure</h6>
                                <p class="small text-muted mb-0">Verified donors and hospitals only</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Features Section -->
<section class="features py-5 bg-white">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="fw-bold mb-3">Why Choose BioHem?</h2>
            <p class="text-muted">BioHem ensures safe, efficient, and reliable blood bank management through secure data handling and real-time tracking.
It streamlines donor, inventory, and transfusion processes to reduce errors and save critical time.
With a user-friendly system and accurate records, BioHem supports timely and life-saving decisions.</p>
        </div>
        
        <div class="row g-4">
            <div class="col-md-4">
                <div class="feature-card p-4 text-center border rounded-3 h-100 animate__animated animate__fadeInUp">
                    <div class="icon-wrapper bg-danger bg-opacity-10 rounded-circle p-3 mb-3 mx-auto" style="width: 80px; height: 80px;">
                        <i class="bi bi-lightning-charge-fill text-danger fs-2"></i>
                    </div>
                    <h5>Instant Matching</h5>
                    <p class="text-muted">Real-time donor matching with hospital requests for urgent needs.</p>
                </div>
            </div>
            
            <div class="col-md-4">
                <div class="feature-card p-4 text-center border rounded-3 h-100 animate__animated animate__fadeInUp" style="animation-delay: 0.2s;">
                    <div class="icon-wrapper bg-primary bg-opacity-10 rounded-circle p-3 mb-3 mx-auto" style="width: 80px; height: 80px;">
                        <i class="bi bi-bar-chart-fill text-primary fs-2"></i>
                    </div>
                    <h5>Smart Analytics</h5>
                    <p class="text-muted">Comprehensive dashboard with real-time blood inventory tracking.</p>
                </div>
            </div>
            
            <div class="col-md-4">
                <div class="feature-card p-4 text-center border rounded-3 h-100 animate__animated animate__fadeInUp" style="animation-delay: 0.4s;">
                    <div class="icon-wrapper bg-success bg-opacity-10 rounded-circle p-3 mb-3 mx-auto" style="width: 80px; height: 80px;">
                        <i class="bi bi-shield-lock-fill text-success fs-2"></i>
                    </div>
                    <h5>Secure & Private</h5>
                    <p class="text-muted">End-to-end encrypted data protection for all users.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- How It Works -->
<section class="how-it-works py-5 bg-light">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="fw-bold mb-3">How BioHem Works</h2>
            <p class="text-muted">Simple three-step process to save lives</p>
        </div>
        
        <div class="row g-4">
            <div class="col-md-4">
                <div class="step-card p-4 text-center position-relative">
                    <div class="step-number bg-danger text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" 
                         style="width: 60px; height: 60px; font-size: 1.5rem; font-weight: bold;">
                        1
                    </div>
                    <h5>Register</h5>
                    <p class="text-muted">Donors and hospitals register on our secure platform.</p>
                    <div class="step-icon mt-3">
                        <i class="bi bi-person-plus-fill text-danger fs-1"></i>
                    </div>
                </div>
            </div>
            
            <div class="col-md-4">
                <div class="step-card p-4 text-center position-relative">
                    <div class="step-number bg-danger text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" 
                         style="width: 60px; height: 60px; font-size: 1.5rem; font-weight: bold;">
                        2
                    </div>
                    <h5>Connect</h5>
                    <p class="text-muted">Hospitals request blood, system finds matching donors.</p>
                    <div class="step-icon mt-3">
                        <i class="bi bi-heart-pulse text-danger fs-1"></i>
                    </div>
                </div>
            </div>
            
            <div class="col-md-4">
                <div class="step-card p-4 text-center position-relative">
                    <div class="step-number bg-danger text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" 
                         style="width: 60px; height: 60px; font-size: 1.5rem; font-weight: bold;">
                        3
                    </div>
                    <h5>Save Lives</h5>
                    <p class="text-muted">Blood reaches those in need, saving lives efficiently.</p>
                    <div class="step-icon mt-3">
                        <i class="bi bi-award-fill text-danger fs-1"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- About Creator -->
<section class="about-creator py-5 bg-white">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-4 text-center animate__animated animate__fadeInLeft">
                <div class="creator-photo-wrapper position-relative">
                    <!-- Using your psr.png image -->
                    <img src="/images/psr.png" 
                         alt="Pushpita Sikder Reya" 
                         class="img-fluid rounded-circle border border-4 border-white shadow"
                         style="width: 250px; height: 250px; object-fit: cover;">
                    <div class="badge bg-danger position-absolute bottom-0 end-0 p-2 rounded-circle">
                        <i class="bi bi-code-slash text-white"></i>
                    </div>
                </div>
            </div>
            
            <div class="col-md-8 animate__animated animate__fadeInRight">
                <h3 class="fw-bold mb-3">About the Creator</h3>
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title text-danger">Pushpita Sikder Reya</h5>
                        <h6 class="text-muted mb-3">
                            <i class="bi bi-mortarboard-fill me-2"></i>Computer Science & Engineering Student
                        </h6>
                        <p class="card-text">
                            A passionate developer from Sylhet Engineering College, dedicated to creating 
                            impactful solutions that address real-world challenges. BioHem was born from 
                            the vision to modernize blood bank management and make the donation process 
                            more efficient and accessible.
                        </p>
                        <p class="card-text">
                            This project combines technical expertise with social responsibility, aiming 
                            to bridge the gap between blood donors and recipients through technology.
                        </p>
                        <div class="mt-4">
                            <span class="badge bg-danger me-2 p-2">HTML</span>
                            <span class="badge bg-primary me-2 p-2">CSS</span>
                            <span class="badge bg-success me-2 p-2">MySQL</span>
                            <span class="badge bg-warning me-2 p-2">Express</span>
                            <span class="badge bg-info me-2 p-2">EJS</span>
                            <span class="badge bg-dark me-2 p-2">Node.js</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- College Info -->
<section class="college-info py-5 bg-light">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-3 text-center">
                <!-- Using your college logo -->
                <img src="/images/college-placeholder.png" 
                     alt="Sylhet Engineering College" 
                     class="img-fluid mb-3"
                     style="max-height: 120px;">
            </div>
            <div class="col-md-6">
                <h3 class="fw-bold mb-3">
                    <i class="bi bi-building text-danger me-2"></i>Sylhet Engineering College
                </h3>
                <p class="text-muted">
                    Sylhet Engineering College (SEC) stands as a premier institution for technical 
                    education in Bangladesh, nurturing innovative minds and fostering research-driven 
                    learning. The college encourages students to develop practical solutions that 
                    contribute to societal welfare.
                </p>
                <p class="text-muted">
                    This project exemplifies SEC's commitment to producing graduates who not only 
                    excel academically but also create meaningful impact through technology.
                </p>
            </div>
            <div class="col-md-3">
                <div class="card border-0 bg-white shadow-sm">
                    <div class="card-body text-center p-4">
                        <i class="bi bi-award-fill text-warning fs-1 mb-3"></i>
                        <h5>Academic Excellence</h5>
                        <p class="small text-muted mb-0">Project developed as part of academic curriculum</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Blood Types Info -->
<section class="blood-types py-5 bg-white">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="fw-bold mb-3">Common Blood Types</h2>
            <p class="text-muted">Understanding blood compatibility can save lives</p>
        </div>
        
        <div class="row g-3">
            <div class="col-6 col-md-3">
                <div class="blood-type-card text-center p-3 border rounded-3">
                    <div class="blood-type-badge bg-danger text-white rounded-circle mx-auto mb-2" 
                         style="width: 60px; height: 60px; line-height: 60px; font-weight: bold;">
                        A+
                    </div>
                    <h6 class="mb-1">A Positive</h6>
                    <p class="small text-muted mb-0">Most common type</p>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="blood-type-card text-center p-3 border rounded-3">
                    <div class="blood-type-badge bg-danger text-white rounded-circle mx-auto mb-2" 
                         style="width: 60px; height: 60px; line-height: 60px; font-weight: bold;">
                        O+
                    </div>
                    <h6 class="mb-1">O Positive</h6>
                    <p class="small text-muted mb-0">Universal donor</p>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="blood-type-card text-center p-3 border rounded-3">
                    <div class="blood-type-badge bg-danger text-white rounded-circle mx-auto mb-2" 
                         style="width: 60px; height: 60px; line-height: 60px; font-weight: bold;">
                        B+
                    </div>
                    <h6 class="mb-1">B Positive</h6>
                    <p class="small text-muted mb-0">Asian common</p>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="blood-type-card text-center p-3 border rounded-3">
                    <div class="blood-type-badge bg-danger text-white rounded-circle mx-auto mb-2" 
                         style="width: 60px; height: 60px; line-height: 60px; font-weight: bold;">
                        AB+
                    </div>
                    <h6 class="mb-1">AB Positive</h6>
                    <p class="small text-muted mb-0">Universal recipient</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="cta-section py-5 bg-danger text-white">
    <div class="container text-center">
        <h2 class="fw-bold mb-4">Ready to Make a Difference?</h2>
        <p class="lead mb-4">Join thousands of life-savers in our community today</p>
        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <a href="/auth/register/donor" class="btn btn-light btn-lg px-4">
                <i class="bi bi-person-plus-fill me-2 text-danger"></i>Register as Donor
            </a>
            <a href="/auth/register/hospital" class="btn btn-light btn-lg px-4">
                <i class="bi bi-hospital me-2"></i>Register Hospital
            </a>
            <a href="/auth/login" class="btn btn-light btn-lg px-4">
                <i class="bi bi-box-arrow-in-right me-2 text-danger"></i>Login Now
            </a>
        </div>
        <p class="small mt-4 mb-0 opacity-75">
            <i class="bi bi-shield-check me-1"></i>Your data is 100% secure and confidential
        </p>
    </div>
</section>

<!-- Trust Indicators -->
<section class="trust-indicators py-4 bg-dark text-white">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-4 text-center mb-3 mb-md-0">
                <div class="d-flex align-items-center justify-content-center">
                    <i class="bi bi-shield-check text-success fs-3 me-3"></i>
                    <div class="text-start">
                        <h6 class="mb-0">Secure Platform</h6>
                        <small class="opacity-75">SSL Encrypted</small>
                    </div>
                </div>
            </div>
            <div class="col-md-4 text-center mb-3 mb-md-0">
                <div class="d-flex align-items-center justify-content-center">
                    <i class="bi bi-clock-history text-warning fs-3 me-3"></i>
                    <div class="text-start">
                        <h6 class="mb-0">24/7 Available</h6>
                        <small class="opacity-75">Always ready to help</small>
                    </div>
                </div>
            </div>
            <div class="col-md-4 text-center">
                <div class="d-flex align-items-center justify-content-center">
                    <i class="bi bi-people-fill text-info fs-3 me-3"></i>
                    <div class="text-start">
                        <h6 class="mb-0">Verified Community</h6>
                        <small class="opacity-75">Trusted donors & hospitals</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .step-card {
        transition: transform 0.3s ease;
    }
    
    .step-card:hover {
        transform: translateY(-5px);
    }
    
    .step-number {
        box-shadow: 0 4px 15px rgba(211, 47, 47, 0.3);
    }
    
    .blood-type-card {
        transition: all 0.3s ease;
    }
    
    .blood-type-card:hover {
        transform: scale(1.05);
        border-color: var(--primary-red) !important;
    }
    
    .blood-type-badge {
        transition: all 0.3s ease;
    }
    
    .blood-type-card:hover .blood-type-badge {
        transform: rotate(10deg);
        box-shadow: 0 5px 20px rgba(211, 47, 47, 0.4);
    }
    
    .trust-indicators i {
        opacity: 0.9;
    }
</style>